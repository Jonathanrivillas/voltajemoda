@implements IDisposable
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@using VoltajeModa.Services

@inject NavigationManager NavigationManager
@inject CarritoEstadoService CarritoEstado
@inject IProductoApiClient ProductoApi
@inject SesionUsuarioService Sesion

<div class="promo-bar" id="promoBar">Suscríbete y obtén el 15%DTO. en tu primera compra</div>

<nav class="navbar navbar-expand-lg voltaje-navbar sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand voltaje-brand" href="/">VOLTAJE</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
                aria-controls="navbarMenu" aria-expanded="false" aria-label="Mostrar/ocultar menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0 voltaje-nav-links">
                <li class="nav-item">
                    <a class="nav-link @(EsCatalogoGeneral ? "active" : "")" href="/productos">Catálogo</a>
                </li>
                @foreach (var categoria in categoriasPredeterminadas)
                {
                    <li class="nav-item">
                        <a class="nav-link @(EsCategoriaActiva(categoria) ? "active" : "")" href="@ObtenerEnlaceCategoria(categoria)">@categoria</a>
                    </li>
                }
                @foreach (var categoria in categorias.Where(c => !categoriasPredeterminadas.Contains(c.Nombre, StringComparer.OrdinalIgnoreCase)))
                {
                    <li class="nav-item">
                        <a class="nav-link @(EsCategoriaActiva(categoria.CategoriaId) ? "active" : "")" href="@($"productos?categoriaId={categoria.CategoriaId}")">@categoria.Nombre</a>
                    </li>
                }
                @if (Sesion.EstaAutenticado && (Sesion.Rol is "Administrador" or "Empleado"))
                {
                    <li class="nav-item"><NavLink class="nav-link" href="/admin/productos">Panel Admin</NavLink></li>
                }
            </ul>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <form action="/productos" method="get" class="voltaje-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                        <path d="m21 21-4.34-4.34" />
                        <circle cx="11" cy="11" r="8" />
                    </svg>
                    <input type="search" name="buscar" class="form-control form-control-sm" placeholder="Buscar" aria-label="Buscar productos" />
                </form>

                <div class="dropdown">
                    <button class="voltaje-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Cuenta">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                        @if (Sesion.EstaAutenticado)
                        {
                                <li class="user-dropdown-header">
                                    <div class="account-avatar">@iniciales</div>
                                    <div class="user-dropdown-info">
                                        <div class="user-dropdown-name">@Sesion.Correo</div>
                                        <div class="user-dropdown-email">@correo</div>
                                        <div class="user-dropdown-email">@Sesion.Rol</div>
                                    </div>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item user-dropdown-link" href="Account/Manage">
                                        <IconoSvg Nombre="usuario" />
                                        <span>Mi cuenta</span>
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item user-dropdown-link" href="mis-pedidos">
                                        <IconoSvg Nombre="caja" />
                                        <span>Mis pedidos</span>
                                    </NavLink>
                                </li>
                                @if (Sesion.Rol is "Administrador" or "Empleado")
                                {
                                    <li>
                                        <NavLink class="dropdown-item user-dropdown-link" href="admin">
                                            <IconoSvg Nombre="panel" />
                                            <span>Admin</span>
                                        </NavLink>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <button type="button" class="dropdown-item user-dropdown-link user-dropdown-logout" @onclick="CerrarSesion">
                                        <IconoSvg Nombre="salir" />
                                        <span>Cerrar sesión</span>
                                    </button>
                                </li>
                        }
                        else
                        {
                                <li><NavLink class="dropdown-item user-dropdown-link" href="Account/Login">Ingresar</NavLink></li>
                                <li><NavLink class="dropdown-item user-dropdown-link" href="Account/Register">Registrarse</NavLink></li>
                        }
                    </ul>
                </div>

                <button type="button" class="voltaje-icon-btn position-relative" @onclick="AbrirCarrito" aria-label="Carrito">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                        <path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18" />
                        <path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25" />
                        <circle cx="18" cy="20" r="2" />
                        <circle cx="8" cy="20" r="2" />
                    </svg>
                    @if (cantidadCarrito > 0)
                    {
                        <span class="cart-badge">@cantidadCarrito</span>
                    }
                </button>
            </div>
        </div>
    </div>
</nav>

<CarritoDrawer @ref="carritoDrawer" />

@code {
    private string? currentUrl;
    private List<CategoriaDto> categorias = new();
    private readonly string[] categoriasPredeterminadas = ["Superiores", "Inferiores", "Conjuntos", "Vestidos", "Enterizos"];
    private CarritoDrawer? carritoDrawer;
    private int cantidadCarrito;
    private string? correo;
    private string iniciales = "?";

    // NavLink con Match="All" no distingue diferencias de query string de forma confiable acá
    // (queda "active" aunque haya un categoriaId en la URL), así que el estado de "Catálogo" se
    // calcula a mano a partir de currentUrl en vez de depender de su matching automático.
    private bool EsCatalogoGeneral => currentUrl == "productos";

    private bool EsCategoriaActiva(int categoriaId)
    {
        var parametro = currentUrl?.Split('?', 2).ElementAtOrDefault(1);
        return parametro?.Split('&').Any(par =>
            par.Equals($"categoriaId={categoriaId}", StringComparison.OrdinalIgnoreCase)) == true;
    }

    private bool EsCategoriaActiva(string nombre)
    {
        var categoria = categorias.FirstOrDefault(c => c.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
        if (categoria is not null)
            return EsCategoriaActiva(categoria.CategoriaId);

        var parametro = currentUrl?.Split('?', 2).ElementAtOrDefault(1);
        var valorBusqueda = parametro?.Split('&')
            .FirstOrDefault(par => par.StartsWith("buscar=", StringComparison.OrdinalIgnoreCase))?
            .Split('=', 2).ElementAtOrDefault(1);

        return valorBusqueda is not null
            && Uri.UnescapeDataString(valorBusqueda).Equals(nombre, StringComparison.OrdinalIgnoreCase);
    }

    private string ObtenerEnlaceCategoria(string nombre)
    {
        var categoria = categorias.FirstOrDefault(c => c.Nombre.Equals(nombre, StringComparison.OrdinalIgnoreCase));
        return categoria is null
            ? $"productos?buscar={Uri.EscapeDataString(nombre)}"
            : $"productos?categoriaId={categoria.CategoriaId}";
    }

    protected override async Task OnInitializedAsync()
    {
        categorias = await ProductoApi.ObtenerCategoriasAsync();

        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        CarritoEstado.Cambio += OnCarritoCambio;
        Sesion.OnChange += OnSesionCambio;
        correo = Sesion.Correo;
        iniciales = AvatarUtils.CalcularIniciales(correo);
        await ActualizarContadorAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // La cuenta de items del carrito depende de ObtenerOCrearCarritoAsync, que para
            // invitados lee un id anónimo desde el almacenamiento local del navegador (JS interop):
            // eso no está disponible durante el prerender, por eso se carga recién acá.
            await ActualizarContadorAsync();
            StateHasChanged();
        }
    }

    private async Task ActualizarContadorAsync()
    {
        if (!Sesion.EstaAutenticado || Sesion.Rol != "Cliente")
        {
            cantidadCarrito = 0;
            return;
        }

        var carrito = await ProductoApi.ObtenerCarritoAsync();
        cantidadCarrito = carrito?.Items.Sum(i => i.Cantidad) ?? 0;
    }

    private async void OnCarritoCambio()
    {
        await InvokeAsync(async () =>
        {
            await ActualizarContadorAsync();
            StateHasChanged();
        });
    }

    private async Task AbrirCarrito()
    {
        if (carritoDrawer is not null)
        {
            await carritoDrawer.AbrirAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private void OnSesionCambio()
    {
        correo = Sesion.Correo;
        iniciales = AvatarUtils.CalcularIniciales(correo);
        _ = InvokeAsync(async () =>
        {
            await ActualizarContadorAsync();
            StateHasChanged();
        });
    }

    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        CarritoEstado.Cambio -= OnCarritoCambio;
        Sesion.OnChange -= OnSesionCambio;
    }
}
