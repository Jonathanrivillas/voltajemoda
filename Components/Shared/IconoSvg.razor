<svg width="@Width" height="@Height" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="@CssClass" aria-hidden="true">
    @switch (Nombre)
    {
        case "usuario":
            <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.6" />
            <path d="M4.5 20c1.4-3.6 4.4-5.6 7.5-5.6s6.1 2 7.5 5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            break;
        case "correo":
            <rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.6" />
            <path d="M4.5 7l7.5 6 7.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "candado":
            <rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.6" />
            <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="currentColor" stroke-width="1.6" />
            break;
        case "ubicacion":
            <path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.6" />
            break;
        case "caja":
            <path d="M3.5 8.5 12 4l8.5 4.5L12 13 3.5 8.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M3.5 8.5V16l8.5 4.5m0-11v11m8.5-11.5V16L12 20.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            break;
        case "escudo":
            <path d="M12 3.5 19 6v5.5c0 4.6-3 7.8-7 9-4-1.2-7-4.4-7-9V6l7-2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M9.2 12.2l1.9 1.9 3.7-3.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "llave":
            <circle cx="8" cy="15.5" r="3.2" stroke="currentColor" stroke-width="1.6" />
            <path d="M10.3 13.2 17.5 6m0 0v3m0-3h-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "documento":
            <path d="M7 3.5h7l4 4V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            break;
        case "enlace":
            <path d="M9.5 13.5 14.5 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path d="M11 6.5l1-1a3.2 3.2 0 0 1 4.5 4.5l-1.5 1.5M13 17.5l-1 1a3.2 3.2 0 0 1-4.5-4.5l1.5-1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            break;
        case "check":
            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6" />
            <path d="M8.5 12.3l2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "alerta":
            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6" />
            <path d="M12 8v4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="12" cy="15.7" r="0.9" fill="currentColor" />
            break;
        case "salir":
            <path d="M14 4H7a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M10 12h9m0 0-3-3m3 3-3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "panel":
            <rect x="4" y="4" width="7" height="7" rx="1.3" stroke="currentColor" stroke-width="1.6" />
            <rect x="13" y="4" width="7" height="7" rx="1.3" stroke="currentColor" stroke-width="1.6" />
            <rect x="4" y="13" width="7" height="7" rx="1.3" stroke="currentColor" stroke-width="1.6" />
            <rect x="13" y="13" width="7" height="7" rx="1.3" stroke="currentColor" stroke-width="1.6" />
            break;
        case "caja-vacia":
            <path d="M3.5 8.5 12 4l8.5 4.5L12 13 3.5 8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            <path d="M3.5 8.5V16l8.5 4.5m0-11v11m8.5-11.5V16L12 20.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Nombre { get; set; } = string.Empty;

    [Parameter]
    public int Width { get; set; } = 18;

    [Parameter]
    public int Height { get; set; } = 18;

    [Parameter]
    public string? CssClass { get; set; }
}
