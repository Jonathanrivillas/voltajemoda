@page "/checkout"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using VoltajeModa.Data
@using VoltajeModa.Models
@using VoltajeModa.Services

@inject ApplicationDbContext Db
@inject CarritoService CarritoService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Finalizar compra</PageTitle>

<h1>Finalizar compra</h1>

@if (!cargado)
{
    <Cargando />
}
else if (items is null || items.Count == 0)
{
    <EstadoVacio Mensaje="Tu carrito está vacío." EnlaceTexto="Ver catálogo" EnlaceHref="/productos" />
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <h5>Resumen del pedido</h5>
    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Talla / Color</th>
                <th>Cantidad</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.ProductoVariante!.Producto!.Nombre</td>
                    <td>@item.ProductoVariante.Talla / @item.ProductoVariante.Color</td>
                    <td>@item.Cantidad</td>
                    <td>@((item.ProductoVariante.Producto.PrecioEfectivo * item.Cantidad).ToString("C"))</td>
                </tr>
            }
        </tbody>
    </table>
    <h4 class="text-end">Total: @total.ToString("C")</h4>

    <hr />

    <h5>Dirección de envío</h5>

    @if (usuarioId is not null)
    {
        @if (direcciones.Count > 0 && !mostrarFormularioDireccion)
        {
            <select class="form-select mb-2" style="max-width: 400px;" @bind="selectedDireccionId">
                @foreach (var direccion in direcciones)
                {
                    <option value="@direccion.Id">@direccion.Etiqueta: @direccion.Calle, @direccion.Ciudad, @direccion.CodigoPostal</option>
                }
            </select>
            <button type="button" class="btn btn-link p-0 m-3" @onclick="() => mostrarFormularioDireccion = true">+ Agregar una nueva dirección</button>
        }
        else
        {
            <div class="account-card mb-3" style="max-width: 540px;">
                <div class="account-card-header">
                    <div class="account-card-icon"><IconoSvg Nombre="ubicacion" Width="20" Height="20" /></div>
                    <div>
                        <h2 class="account-card-title h6 mb-0">Nueva dirección de envío</h2>
                        <p class="account-card-subtitle">Se guardará en tu cuenta para tus próximas compras.</p>
                    </div>
                </div>
                <div class="account-card-body">
                    @if (mensajeDireccion is not null)
                    {
                        <div class="alert alert-danger py-2">@mensajeDireccion</div>
                    }
                    <div class="row g-2">
                        <div class="col-md-4">
                            <select class="form-select" @bind="nuevaDireccionUsuario.Etiqueta">
                                <option value="Casa">Casa</option>
                                <option value="Trabajo">Trabajo</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <input class="form-control" placeholder="Nombre de quien recibe" @bind="nuevaDireccionUsuario.NombreDestinatario" />
                        </div>
                        <div class="col-md-6">
                            <input class="form-control" placeholder="Calle" @bind="nuevaDireccionUsuario.Calle" />
                        </div>
                        <div class="col-md-3">
                            <input class="form-control" placeholder="Ciudad" @bind="nuevaDireccionUsuario.Ciudad" />
                        </div>
                        <div class="col-md-3">
                            <input class="form-control" placeholder="Código postal" @bind="nuevaDireccionUsuario.CodigoPostal" />
                        </div>
                        <div class="col-md-6">
                            <input class="form-control" placeholder="Teléfono de contacto" @bind="nuevaDireccionUsuario.Telefono" />
                        </div>
                        <div class="col-12 d-flex align-items-center gap-2 mt-1">
                            <button type="button" class="btn btn-dark btn-sm" @onclick="GuardarDireccionUsuarioAsync">Guardar dirección</button>
                            @if (direcciones.Count > 0)
                            {
                                <button type="button" class="btn btn-link btn-sm" @onclick="() => mostrarFormularioDireccion = false">Cancelar</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Puedes comprar sin crear una cuenta — solo indica dónde enviamos tu pedido.</p>
        <div class="row g-2 mb-3" style="max-width: 500px;">
            <div class="col-12">
                <input class="form-control" placeholder="Calle" @bind="nuevaDireccion.Calle" />
            </div>
            <div class="col-6">
                <input class="form-control" placeholder="Ciudad" @bind="nuevaDireccion.Ciudad" />
            </div>
            <div class="col-6">
                <input class="form-control" placeholder="Código postal" @bind="nuevaDireccion.CodigoPostal" />
            </div>
        </div>
    }

    <button class="btn btn-dark" @onclick="ConfirmarPedido" disabled="@procesando">
        @(procesando ? "Procesando..." : "Confirmar pedido")
    </button>
}

@code {
    private bool cargado;
    private bool procesando;
    private string? usuarioId;
    private string? anonimoId;
    private int? carritoId;
    private List<CarritoItem>? items;
    private List<Direccion> direcciones = new();
    private int? selectedDireccionId;
    private Direccion nuevaDireccion = new();
    private Direccion nuevaDireccionUsuario = new();
    private bool mostrarFormularioDireccion;
    private string? mensajeDireccion;
    private decimal total;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            usuarioId = authState.User.Identity?.IsAuthenticated == true
                ? authState.User.FindFirstValue(ClaimTypes.NameIdentifier)
                : null;

            var carrito = await CarritoService.ObtenerOCrearCarritoAsync(usuarioId);
            carritoId = carrito.Id;

            if (usuarioId is not null)
            {
                direcciones = await Db.Direcciones.Where(d => d.UsuarioId == usuarioId).ToListAsync();
                selectedDireccionId = direcciones.FirstOrDefault(d => d.EsPredeterminada)?.Id ?? direcciones.FirstOrDefault()?.Id;
                mostrarFormularioDireccion = direcciones.Count == 0;
            }
            else
            {
                anonimoId = await CarritoService.ObtenerOCrearIdAnonimoAsync();
            }

            await CargarItemsAsync();
            cargado = true;
            StateHasChanged();
        }
    }

    private async Task CargarItemsAsync()
    {
        items = await Db.CarritoItems
            .Where(i => i.CarritoId == carritoId)
            .Include(i => i.ProductoVariante)
                .ThenInclude(v => v!.Producto)
            .ToListAsync();

        total = items.Sum(i => i.ProductoVariante!.Producto!.PrecioEfectivo * i.Cantidad);
    }

    private async Task GuardarDireccionUsuarioAsync()
    {
        mensajeDireccion = null;

        if (string.IsNullOrWhiteSpace(nuevaDireccionUsuario.Calle) ||
            string.IsNullOrWhiteSpace(nuevaDireccionUsuario.Ciudad) ||
            string.IsNullOrWhiteSpace(nuevaDireccionUsuario.CodigoPostal))
        {
            mensajeDireccion = "Completa calle, ciudad y código postal.";
            return;
        }

        nuevaDireccionUsuario.UsuarioId = usuarioId;
        nuevaDireccionUsuario.EsPredeterminada = direcciones.Count == 0;

        Db.Direcciones.Add(nuevaDireccionUsuario);
        await Db.SaveChangesAsync();

        direcciones.Add(nuevaDireccionUsuario);
        selectedDireccionId = nuevaDireccionUsuario.Id;
        mostrarFormularioDireccion = false;
        nuevaDireccionUsuario = new();
    }

    private async Task ConfirmarPedido()
    {
        error = null;

        if (items is null || items.Count == 0)
        {
            return;
        }

        foreach (var item in items)
        {
            if (item.Cantidad > item.ProductoVariante!.Stock)
            {
                error = $"No hay suficiente stock de {item.ProductoVariante.Producto!.Nombre} ({item.ProductoVariante.Talla}/{item.ProductoVariante.Color}).";
                return;
            }
        }

        int direccionId;

        if (usuarioId is not null)
        {
            if (selectedDireccionId is null || mostrarFormularioDireccion)
            {
                error = "Guarda o selecciona una dirección de envío antes de continuar.";
                return;
            }

            direccionId = selectedDireccionId.Value;
        }
        else
        {
            if (string.IsNullOrWhiteSpace(nuevaDireccion.Calle) ||
                string.IsNullOrWhiteSpace(nuevaDireccion.Ciudad) ||
                string.IsNullOrWhiteSpace(nuevaDireccion.CodigoPostal))
            {
                error = "Completa la dirección de envío.";
                return;
            }

            nuevaDireccion.AnonimoId = anonimoId;
            Db.Direcciones.Add(nuevaDireccion);
            await Db.SaveChangesAsync();
            direccionId = nuevaDireccion.Id;
        }

        procesando = true;

        var pedido = new Pedido
        {
            UsuarioId = usuarioId,
            AnonimoId = usuarioId is null ? anonimoId : null,
            DireccionId = direccionId,
            Fecha = DateTime.UtcNow,
            Estado = EstadoPedido.Pendiente,
            Total = total
        };

        foreach (var item in items)
        {
            pedido.Items.Add(new PedidoItem
            {
                ProductoVarianteId = item.ProductoVarianteId,
                Cantidad = item.Cantidad,
                PrecioUnitario = item.ProductoVariante!.Producto!.PrecioEfectivo
            });

            item.ProductoVariante.Stock -= item.Cantidad;
        }

        Db.Pedidos.Add(pedido);
        Db.CarritoItems.RemoveRange(items);
        await Db.SaveChangesAsync();

        NavigationManager.NavigateTo($"/pedidos/{pedido.Id}");
    }
}
