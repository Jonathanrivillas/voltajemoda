@page "/admin/categorias"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos

@inject IProductoApiClient ProductoApi

<PageTitle>Categorías</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Categorías</h1>
        <p>Organiza el catálogo por categorías.</p>
    </div>
    <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#modalCategoria" @onclick="AbrirNueva">
        <i class="bi bi-plus-lg"></i> Nueva categoría
    </button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (categorias is null)
{
    <Cargando />
}
else if (categorias.Count == 0)
{
    <EstadoVacio Mensaje="Todavía no hay categorías." />
}
else
{
    <div class="admin-categoria-grid">
        @foreach (var categoria in categorias)
        {
            <div class="admin-categoria-card">
                <div class="d-flex align-items-center gap-2">
                    <span class="admin-categoria-avatar">@categoria.Nombre.Substring(0, 1).ToUpperInvariant()</span>
                    <div>
                        <div class="fw-bold">@categoria.Nombre</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <EditForm Model="categoriaEdicion" OnValidSubmit="Guardar">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva categoría</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="categoriaEdicion.Nombre" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<CategoriaDto>? categorias;
    private CategoriaDto categoriaEdicion = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        categorias = (await ProductoApi.ObtenerCategoriasAsync())
            .OrderBy(c => c.Nombre)
            .ToList();
    }

    private void AbrirNueva() => categoriaEdicion = new();

    private async Task Guardar()
    {
        error = null;
        var creada = await ProductoApi.CrearCategoriaAsync(categoriaEdicion.Nombre);

        if (!creada)
        {
            error = "No se pudo guardar la categoría. Inténtalo de nuevo.";
            return;
        }

        categoriaEdicion = new();
        await CargarAsync();
    }
}
