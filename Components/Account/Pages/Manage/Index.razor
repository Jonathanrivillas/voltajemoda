@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos

@inject IProductoApiClient ProductoApi

<PageTitle>Perfil</PageTitle>

<div class="account-card">
    <div class="account-card-header">
        <div class="account-card-icon"><IconoSvg Nombre="usuario" Width="20" Height="20" /></div>
        <div>
            <h2 class="account-card-title">Información personal</h2>
            <p class="account-card-subtitle">Actualiza tu nombre y teléfono.</p>
        </div>
    </div>
    <div class="account-card-body">
        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }
        @if (mensaje is not null)
        {
            <div class="alert alert-success">@mensaje</div>
        }

        @if (perfil is null)
        {
            <Cargando />
        }
        else
        {
            <p><strong>Correo:</strong> @perfil.CorreoElectronico</p>
            <p><strong>Rol:</strong> @perfil.Rol</p>
            <EditForm Model="formulario" OnValidSubmit="GuardarPerfil">
                <DataAnnotationsValidator />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="formulario.Nombre" class="form-control" />
                    <label>Nombre</label>
                    <ValidationMessage For="() => formulario.Nombre" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="formulario.Apellido" class="form-control" />
                    <label>Apellido</label>
                    <ValidationMessage For="() => formulario.Apellido" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="formulario.Telefono" class="form-control" />
                    <label>Teléfono</label>
                </div>
                <button type="submit" class="btn btn-primary">Guardar perfil</button>
            </EditForm>
        }
    </div>
</div>

<div class="account-card">
    <div class="account-card-header">
        <div class="account-card-icon"><IconoSvg Nombre="candado" Width="20" Height="20" /></div>
        <div><h2 class="account-card-title">Cambiar contraseña</h2></div>
    </div>
    <div class="account-card-body">
        <EditForm Model="passwordForm" OnValidSubmit="CambiarPassword">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="passwordForm.PasswordActual" class="form-control" />
                <label>Contraseña actual</label>
                <ValidationMessage For="() => passwordForm.PasswordActual" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="passwordForm.NuevaPassword" class="form-control" />
                <label>Nueva contraseña</label>
                <ValidationMessage For="() => passwordForm.NuevaPassword" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-outline-dark">Actualizar contraseña</button>
        </EditForm>
    </div>
</div>

@code {
    private PerfilDto? perfil;
    private PerfilInput formulario = new();
    private PasswordInput passwordForm = new();
    private string? error;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        perfil = await ProductoApi.ObtenerPerfilAsync();
        if (perfil is not null)
        {
            formulario.Nombre = perfil.Nombre ?? string.Empty;
            formulario.Apellido = perfil.Apellido ?? string.Empty;
            formulario.Telefono = perfil.Telefono ?? string.Empty;
        }
    }

    private async Task GuardarPerfil()
    {
        error = null;
        mensaje = null;
        if (await ProductoApi.ActualizarPerfilAsync(new ActualizarPerfilApiDto
        {
            Nombre = formulario.Nombre,
            Apellido = formulario.Apellido,
            Telefono = formulario.Telefono
        }))
        {
            mensaje = "Perfil actualizado.";
            perfil = await ProductoApi.ObtenerPerfilAsync();
        }
        else
        {
            error = "No se pudo actualizar el perfil.";
        }
    }

    private async Task CambiarPassword()
    {
        error = null;
        mensaje = null;
        if (await ProductoApi.CambiarPasswordAsync(new CambiarPasswordApiDto
        {
            PasswordActual = passwordForm.PasswordActual,
            NuevaPassword = passwordForm.NuevaPassword
        }))
        {
            mensaje = "Contraseña actualizada.";
            passwordForm = new();
        }
        else
        {
            error = "No se pudo cambiar la contraseña. Verifica la contraseña actual.";
        }
    }

    private sealed class PerfilInput
    {
        [Required(ErrorMessage = "Ingresa tu nombre.")]
        public string Nombre { get; set; } = string.Empty;
        [Required(ErrorMessage = "Ingresa tu apellido.")]
        public string Apellido { get; set; } = string.Empty;
        public string? Telefono { get; set; }
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Ingresa tu contraseña actual.")]
        public string PasswordActual { get; set; } = string.Empty;
        [Required(ErrorMessage = "Ingresa la nueva contraseña.")]
        [StringLength(100, MinimumLength = 8)]
        public string NuevaPassword { get; set; } = string.Empty;
    }
}
