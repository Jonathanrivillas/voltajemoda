@page "/admin/pedidos/{Id:int}"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@inject IProductoApiClient ProductoApi

<PageTitle>Pedido #@Id</PageTitle>
<div class="admin-page-header">
    <div><h1>Pedido #@Id</h1></div>
    <a href="/admin/pedidos" class="btn btn-outline-dark">Volver a pedidos</a>
</div>
@if (pedido is null)
{
    <Cargando />
}
else
{
    <div class="row g-3">
        <div class="col-lg-8">
            <AdminCard Titulo="Artículos">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead><tr><th>Producto</th><th>Talla / Color</th><th>Cantidad</th><th>Precio</th></tr></thead>
                        <tbody>
                            @foreach (var item in pedido.Detalles)
                            {
                                <tr><td>@item.NombreProducto</td><td>@item.Talla / @item.Color</td><td>@item.Cantidad</td><td>@item.PrecioUnitario.ToString("C")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <h4 class="text-end mt-3">Total: @pedido.Total.ToString("C")</h4>
            </AdminCard>
        </div>
        <div class="col-lg-4">
            <AdminCard Titulo="Información del pedido">
                <p><strong>Cliente:</strong> @pedido.NombreCliente</p>
                <p><strong>Correo:</strong> @pedido.CorreoCliente</p>
                <p><strong>Estado:</strong> @pedido.Estado</p>
                <p><strong>Fecha:</strong> @pedido.FechaPedido?.ToLocalTime().ToString("g")</p>
                <p><strong>Dirección:</strong> @pedido.DireccionEnvio, @pedido.CiudadEnvio</p>
                <p><strong>Método de pago:</strong> @pedido.MetodoPago</p>
            </AdminCard>
        </div>
    </div>
}
@code {
    [Parameter] public int Id { get; set; }
    private PedidoAdminDto? pedido;
    protected override async Task OnInitializedAsync() => pedido = await ProductoApi.ObtenerPedidoAdminAsync(Id);
}
