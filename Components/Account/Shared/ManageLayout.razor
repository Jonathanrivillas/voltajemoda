@inherits LayoutComponentBase
@layout VoltajeModa.Components.Layout.MainLayout
@using VoltajeModa.Services

@inject SesionUsuarioService Sesion
@inject NavigationManager NavigationManager

<div class="account-shell">
    <div class="account-header">
        <h1>Mi cuenta</h1>
        <p>Administra tu perfil, direcciones y pedidos.</p>
    </div>

    @if (Sesion.EstaAutenticado)
    {
        <div class="account-grid">
            <aside class="account-sidebar">
                <div class="account-sidebar-card">
                    <div class="account-user">
                        <div class="account-avatar">@(Sesion.Correo?.Trim().Substring(0, 1).ToUpperInvariant() ?? "?")</div>
                        <div class="account-user-info">
                            <div class="account-user-name">@Sesion.Correo</div>
                            <div class="account-user-email">@Sesion.Rol</div>
                        </div>
                    </div>
                    <ManageNavMenu />
                </div>
            </aside>
            <div class="account-content">
                @Body
            </div>
        </div>
    }
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!Sesion.EstaAutenticado)
        {
            NavigationManager.NavigateTo("/Account/Login");
        }
    }
}
