@page "/Account/Manage/Direcciones"

@using System.ComponentModel.DataAnnotations
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos

@inject IProductoApiClient ProductoApi

<PageTitle>Direcciones de envío</PageTitle>

<div class="account-card">
    <div class="account-card-header">
        <div class="account-card-icon"><IconoSvg Nombre="ubicacion" Width="20" Height="20" /></div>
        <div>
            <h2 class="account-card-title">Direcciones de envío</h2>
            <p class="account-card-subtitle">Guarda tus direcciones para elegirlas rápido al pagar.</p>
        </div>
    </div>
    <div class="account-card-body">
        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }
        <EditForm Model="formulario" OnValidSubmit="GuardarDireccion" class="mb-4">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Etiqueta</label>
                    <InputSelect @bind-Value="formulario.Etiqueta" class="form-select">
                        <option value="Casa">Casa</option>
                        <option value="Trabajo">Trabajo</option>
                        <option value="Otro">Otro</option>
                    </InputSelect>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Dirección física</label>
                    <InputText @bind-Value="formulario.DireccionFisica" class="form-control" />
                    <ValidationMessage For="() => formulario.DireccionFisica" class="text-danger" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ciudad</label>
                    <InputText @bind-Value="formulario.Ciudad" class="form-control" />
                    <ValidationMessage For="() => formulario.Ciudad" class="text-danger" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Agregar dirección</button>
                </div>
            </div>
        </EditForm>

        @if (direcciones.Count == 0)
        {
            <EstadoVacio Mensaje="Todavía no tienes direcciones guardadas." />
        }
        else
        {
            <div class="account-address-grid">
                @foreach (var direccion in direcciones)
                {
                    <div class="account-address-card">
                        <div class="account-address-top"><span class="account-address-label">@direccion.Etiqueta</span></div>
                        <p class="account-address-text">@direccion.DireccionFisica, @direccion.Ciudad</p>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarDireccion(direccion.DireccionId)">Eliminar</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<DireccionDto> direcciones = new();
    private DireccionInput formulario = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        direcciones = await ProductoApi.ObtenerDireccionesAsync();
    }

    private async Task GuardarDireccion()
    {
        error = null;
        if (!await ProductoApi.CrearDireccionAsync(new CrearDireccionApiDto
        {
            Etiqueta = formulario.Etiqueta,
            DireccionFisica = formulario.DireccionFisica,
            Ciudad = formulario.Ciudad
        }))
        {
            error = "No se pudo guardar la dirección.";
            return;
        }

        formulario = new();
        direcciones = await ProductoApi.ObtenerDireccionesAsync();
    }

    private async Task EliminarDireccion(int id)
    {
        if (!await ProductoApi.EliminarDireccionAsync(id))
        {
            error = "No se pudo eliminar la dirección.";
            return;
        }

        direcciones = await ProductoApi.ObtenerDireccionesAsync();
    }

    private sealed class DireccionInput
    {
        public string Etiqueta { get; set; } = "Casa";

        [Required(ErrorMessage = "Ingresa la dirección.")]
        public string DireccionFisica { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la ciudad.")]
        public string Ciudad { get; set; } = string.Empty;
    }
}
