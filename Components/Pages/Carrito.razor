@page "/carrito"

@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@using VoltajeModa.Services

@inject IProductoApiClient ProductoApi
@inject SesionUsuarioService Sesion
@inject CarritoEstadoService CarritoEstado
@inject NavigationManager NavigationManager

<PageTitle>Carrito</PageTitle>

<h1>Tu carrito</h1>

@if (!cargado)
{
    <Cargando />
}
else if (Sesion.Rol != "Cliente")
{
    <EstadoVacio Mensaje="Inicia sesión con una cuenta de cliente para consultar el carrito."
                 EnlaceTexto="Ingresar" EnlaceHref="/Account/Login" />
}
else if (carrito.Items.Count == 0)
{
    <EstadoVacio Mensaje="Tu carrito está vacío." EnlaceTexto="Ver catálogo" EnlaceHref="/productos" />
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <table class="table align-middle">
        <thead>
            <tr><th>Producto</th><th>Talla / Color</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in carrito.Items)
            {
                <tr>
                    <td>@item.NombreProducto</td>
                    <td>@item.Talla / @item.Color</td>
                    <td>@item.PrecioUnitario.ToString("C")</td>
                    <td style="width: 120px;">
                        <input type="number" class="form-control" min="1" value="@item.Cantidad"
                               @onchange="@(e => ActualizarCantidad(item.CarritoItemId, e.Value))" />
                    </td>
                    <td>@item.Subtotal.ToString("C")</td>
                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarItem(item.CarritoItemId)">Eliminar</button></td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-end">Total: @carrito.Total.ToString("C")</h4>
    @if (direcciones.Count > 0)
    {
        <label class="form-label">Dirección de envío</label>
        <select class="form-select mb-3" @bind="direccionSeleccionadaId">
            @foreach (var direccionGuardada in direcciones)
            {
                <option value="@direccionGuardada.DireccionId">@direccionGuardada.Etiqueta: @direccionGuardada.DireccionFisica, @direccionGuardada.Ciudad</option>
            }
        </select>
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-md-4"><input class="form-control" placeholder="Etiqueta" @bind="direccion.Etiqueta" /></div>
            <div class="col-md-5"><input class="form-control" placeholder="Dirección" @bind="direccion.DireccionFisica" /></div>
            <div class="col-md-3"><input class="form-control" placeholder="Ciudad" @bind="direccion.Ciudad" /></div>
        </div>
    }
    <label class="form-label">Método de pago</label>
    <select class="form-select mb-3" @bind="metodoPagoId">
        <option value="0">Selecciona un método</option>
        @foreach (var metodo in metodosPago)
        {
            <option value="@metodo.MetodoPagoId">@metodo.NombreMetodo</option>
        }
    </select>
    <div class="text-end">
        <button class="btn btn-dark" @onclick="ConfirmarPedido" disabled="@procesando">
            @(procesando ? "Procesando..." : "Confirmar y Pagar Pedido")
        </button>
    </div>
}

@code {
    private bool cargado;
    private bool procesando;
    private string? error;
    private CarritoDto carrito = new();
    private List<DireccionDto> direcciones = new();
    private List<MetodoPagoDto> metodosPago = new();
    private CrearDireccionApiDto direccion = new();
    private int? direccionSeleccionadaId;
    private int metodoPagoId;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.Rol == "Cliente")
        {
            carrito = await ProductoApi.ObtenerCarritoAsync() ?? new();
            direcciones = await ProductoApi.ObtenerDireccionesAsync();
            metodosPago = await ProductoApi.ObtenerMetodosPagoAsync();
            direccionSeleccionadaId = direcciones.FirstOrDefault()?.DireccionId;
        }

        cargado = true;
    }

    private async Task ActualizarCantidad(int itemId, object? valor)
    {
        error = null;
        if (!int.TryParse(valor?.ToString(), out var nuevaCantidad) || nuevaCantidad < 1
            || !await ProductoApi.ActualizarCantidadCarritoAsync(itemId, nuevaCantidad))
        {
            error = "No se pudo actualizar la cantidad.";
            return;
        }

        await CargarAsync();
    }

    private async Task EliminarItem(int itemId)
    {
        error = null;
        if (!await ProductoApi.EliminarItemCarritoAsync(itemId))
        {
            error = "No se pudo eliminar el producto del carrito.";
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        carrito = await ProductoApi.ObtenerCarritoAsync() ?? new();
        CarritoEstado.Notificar();
    }

    private async Task ConfirmarPedido()
    {
        error = null;
        var direccionEntrega = direccionSeleccionadaId is int id
            ? direcciones.FirstOrDefault(d => d.DireccionId == id)
            : null;

        var direccionEnvio = direccionEntrega?.DireccionFisica ?? direccion.DireccionFisica;
        var ciudadEnvio = direccionEntrega?.Ciudad ?? direccion.Ciudad;
        if (string.IsNullOrWhiteSpace(direccionEnvio) || string.IsNullOrWhiteSpace(ciudadEnvio))
        {
            error = "Selecciona o ingresa una dirección de envío.";
            return;
        }
        if (metodoPagoId <= 0)
        {
            error = "Selecciona un método de pago.";
            return;
        }

        procesando = true;
        var pedido = await ProductoApi.CrearPedidoAsync(new RealizarPedidoApiDto
        {
            DireccionEnvio = direccionEnvio,
            CiudadEnvio = ciudadEnvio,
            MetodoPagoId = metodoPagoId
        });
        procesando = false;

        if (pedido is null || pedido.PedidoId <= 0)
        {
            error = "No se pudo procesar el pedido.";
            return;
        }

        carrito = await ProductoApi.ObtenerCarritoAsync() ?? new();
        CarritoEstado.Notificar();
        NavigationManager.NavigateTo($"/pedidos/{pedido.PedidoId}");
    }
}
