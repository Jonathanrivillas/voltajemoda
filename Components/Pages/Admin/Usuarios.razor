@page "/admin/usuarios"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@inject IProductoApiClient ProductoApi

<PageTitle>Usuarios</PageTitle>
<div class="admin-page-header"><div><h1>Usuarios</h1><p>Consulta clientes y empleados y administra su acceso.</p></div></div>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
@if (usuarios is null)
{
    <Cargando />
}
else
{
    <AdminCard>
        <div class="table-responsive">
            <table class="admin-table">
                <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var usuario in usuarios)
                    {
                        <tr>
                            <td>@usuario.Usuario.Nombre @usuario.Usuario.Apellido</td>
                            <td>@usuario.Usuario.CorreoElectronico</td>
                            <td>
                                <select class="form-select form-select-sm" value="@usuario.Usuario.RolId"
                                        @onchange="e => CambiarRol(usuario, e)">
                                    <option value="1">Administrador</option>
                                    <option value="2">Cliente</option>
                                    <option value="3">Empleado</option>
                                </select>
                            </td>
                            <td>@(usuario.Usuario.Activo ? "Activo" : "Inactivo")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => CambiarEstado(usuario)">
                                    @(usuario.Usuario.Activo ? "Desactivar" : "Activar")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </AdminCard>
}
@code {
    private List<UsuarioFila>? usuarios;
    private string? error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        var clientes = await ProductoApi.ObtenerClientesAdminAsync();
        var empleados = await ProductoApi.ObtenerEmpleadosAdminAsync();
        usuarios = clientes.Select(x => new UsuarioFila(x, "Cliente"))
            .Concat(empleados.Select(x => new UsuarioFila(x, "Empleado")))
            .ToList();
    }

    private async Task CambiarEstado(UsuarioFila fila)
    {
        error = null;
        var exito = fila.Tipo == "Cliente"
            ? await ProductoApi.CambiarEstadoClienteAsync(fila.Usuario.UsuarioId)
            : await ProductoApi.CambiarEstadoEmpleadoAsync(fila.Usuario.UsuarioId);
        if (!exito)
        {
            error = "No se pudo cambiar el estado de la cuenta.";
            return;
        }
        await CargarAsync();
    }

    private async Task CambiarRol(UsuarioFila fila, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var nuevoRolId) || nuevoRolId == fila.Usuario.RolId)
            return;

        error = null;
        if (!await ProductoApi.CambiarRolAsync(fila.Usuario.UsuarioId, nuevoRolId))
        {
            error = "No se pudo cambiar el rol. Si cambiaste un cliente a empleado, verifica los requisitos del backend.";
            return;
        }

        await CargarAsync();
    }

    private sealed record UsuarioFila(UsuarioAdminDto Usuario, string Tipo);
}
