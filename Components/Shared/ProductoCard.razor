@using VoltajeModa.Models

@{
    var imagenes = ObtenerImagenes();
    var tieneVariasImagenes = imagenes.Count > 1;
    var descuentoPorcentaje = ObtenerDescuentoPorcentaje();
}

<div class="card producto-card h-100">
    <div class="producto-card-media">
        @if (descuentoPorcentaje > 0)
        {
            <span class="producto-badge producto-badge-descuento">@descuentoPorcentaje%</span>
        }
        @if (Producto.EsNuevo)
        {
            <span class="producto-badge producto-badge-nuevo">Nuevo</span>
        }

        @for (var i = 0; i < imagenes.Count; i++)
        {
            <img src="@imagenes[i]" class="producto-card-img @(i == 0 ? "activa" : "")" alt="@Producto.Nombre" />
        }

        <a href="/productos/@Producto.Id" class="producto-card-media-link" aria-label="@Producto.Nombre"></a>

        @if (tieneVariasImagenes)
        {
            <button type="button" class="producto-img-nav producto-img-nav-prev" aria-label="Imagen anterior">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <button type="button" class="producto-img-nav producto-img-nav-next" aria-label="Imagen siguiente">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="m9 18 6-6-6-6" /></svg>
            </button>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <a href="/productos/@Producto.Id" class="producto-card-title-link">
            <h5 class="card-title producto-card-title">@Producto.Nombre</h5>
        </a>
        @if (MostrarCategoria && Producto.Categoria is not null)
        {
            <p class="card-text text-muted small mb-1">@Producto.Categoria.Nombre</p>
        }
        <p class="producto-card-precio">
            @if (Producto.EnOferta && Producto.PrecioOferta is not null)
            {
                <span class="producto-precio-oferta">@Producto.PrecioEfectivo.ToString("C")</span>
                <span class="producto-precio-original">@Producto.Precio.ToString("C")</span>
            }
            else
            {
                <span class="producto-precio-normal">@Producto.Precio.ToString("C")</span>
            }
        </p>
        <a href="/productos/@Producto.Id" class="btn btn-dark producto-card-btn mt-auto">
            Agregar al carrito
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18" />
                <path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25" />
                <circle cx="18" cy="20" r="2" />
                <circle cx="8" cy="20" r="2" />
            </svg>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Producto Producto { get; set; } = default!;

    [Parameter]
    public bool MostrarCategoria { get; set; } = true;

    private List<string> ObtenerImagenes()
    {
        var imagenes = new List<string>();
        if (!string.IsNullOrWhiteSpace(Producto.ImagenUrl))
        {
            imagenes.Add(Producto.ImagenUrl);
        }

        imagenes.AddRange(Producto.ImagenesAdicionales
            .OrderBy(i => i.Orden)
            .Select(i => i.Url));

        return imagenes;
    }

    private int ObtenerDescuentoPorcentaje()
    {
        if (!Producto.EnOferta || Producto.PrecioOferta is null || Producto.Precio <= 0)
        {
            return 0;
        }

        return (int)Math.Round((1 - (Producto.PrecioOferta.Value / Producto.Precio)) * 100);
    }
}
