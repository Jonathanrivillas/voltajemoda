@page "/admin/productos"
@inject IProductoApiClient ProductoApi

<PageTitle>Productos</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Productos</h1>
        <p>Gestiona el catálogo y su inventario.</p>
    </div>
    <a href="/admin/productos/nuevo" class="btn btn-dark"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (productos is null)
{
    <Cargando />
}
else if (productos.Count == 0)
{
    <EstadoVacio Mensaje="Todavía no hay productos." EnlaceTexto="Crear el primero" EnlaceHref="/admin/productos/nuevo" />
}
else
{
    <AdminCard>
        <Toolbar>
            <div class="admin-filter-bar">
                <input class="form-control form-control-sm" style="min-width:200px" placeholder="Buscar por nombre..." @bind="busqueda" @bind:event="oninput" />
                <select class="form-select form-select-sm" @bind="categoriaId">
                    <option value="0">Todas las categorías</option>
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.CategoriaId">@categoria.Nombre</option>
                    }
                </select>
                <select class="form-select form-select-sm" @bind="estadoStock">
                    <option value="Todos">Todos los estados</option>
                    <option value="EnStock">En stock</option>
                    <option value="StockBajo">Stock bajo</option>
                    <option value="SinStock">Sin stock</option>
                </select>
            </div>
        </Toolbar>
        <ChildContent>
            @if (ProductosFiltrados.Count == 0)
            {
                <EstadoVacio Mensaje="Ningún producto coincide con los filtros." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th>Variantes</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in ProductosFiltrados)
                            {
                                <tr>
                                    <td>@producto.Nombre</td>
                                    <td>@producto.NombreCategoria</td>
                                    <td>@producto.PrecioBase.ToString("C")</td>
                                    <td><StockBadge Stock="producto.Stock" /></td>
                                    <td>@producto.CantidadVariantes</td>
                                    <td class="text-end">
                                        <a href="/admin/productos/@producto.ProductoId/editar" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Editar</a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CambiarEstadoAsync(producto)">
                                            <i class="bi bi-eye-slash"></i> Desactivar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </AdminCard>
}

@code {
    private List<ProductoDto>? productos;
    private List<CategoriaDto> categorias = new();
    private string? error;
    private string busqueda = "";
    private int categoriaId;
    private string estadoStock = "Todos";

    protected override async Task OnInitializedAsync()
    {
        categorias = await ProductoApi.ObtenerCategoriasAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var catalogo = await ProductoApi.ObtenerCatalogoAsync(tamanoPagina: 100);
        productos = catalogo?.Productos ?? new List<ProductoDto>();
    }

    private List<ProductoDto> ProductosFiltrados
    {
        get
        {
            if (productos is null) return new();

            IEnumerable<ProductoDto> query = productos;
            if (!string.IsNullOrWhiteSpace(busqueda))
            {
                query = query.Where(p => p.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase));
            }

            if (categoriaId > 0)
            {
                query = query.Where(p => p.CategoriaId == categoriaId);
            }

            query = estadoStock switch
            {
                "SinStock" => query.Where(p => p.Stock == 0),
                "StockBajo" => query.Where(p => p.Stock > 0 && p.Stock <= 5),
                "EnStock" => query.Where(p => p.Stock > 5),
                _ => query
            };

            return query.ToList();
        }
    }

    private async Task CambiarEstadoAsync(ProductoDto producto)
    {
        error = null;
        if (!await ProductoApi.CambiarEstadoProductoAsync(producto.ProductoId))
        {
            error = $"No se pudo desactivar '{producto.Nombre}'.";
            return;
        }

        await CargarAsync();
    }
}
