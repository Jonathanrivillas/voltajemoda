@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using VoltajeModa.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales</PageTitle>

<div class="account-card">
    <div class="account-card-header">
        <div class="account-card-icon"><IconoSvg Nombre="documento" Width="20" Height="20" /></div>
        <div>
            <h2 class="account-card-title">Datos personales</h2>
            <p class="account-card-subtitle">Descarga una copia de tus datos o elimina tu cuenta de forma permanente.</p>
        </div>
    </div>
    <div class="account-card-body">
        <StatusMessage />
        <div class="row">
            <div class="col-md-6">
                <p>Tu cuenta contiene datos personales que nos proporcionaste. Aquí puedes descargarlos o eliminarlos.</p>
                <p>
                    <strong>Eliminar estos datos borrará tu cuenta de forma permanente y no se puede deshacer.</strong>
                </p>
                <form action="Account/Manage/DownloadPersonalData" method="post">
                    <AntiforgeryToken />
                    <button class="btn btn-primary" type="submit">Descargar</button>
                </form>
                <p class="mt-3">
                    <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Eliminar</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
