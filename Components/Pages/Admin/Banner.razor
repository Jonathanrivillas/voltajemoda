@page "/admin/banner"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@using VoltajeModa.Services
@inject IProductoApiClient ProductoApi
@inject ProductosDestacadosService Destacados

<PageTitle>Productos destacados</PageTitle>
<div class="admin-page-header">
    <div><h1>Productos destacados</h1><p>Selecciona los productos que aparecerán en la portada. La selección se mantiene en memoria mientras dure la sesión.</p></div>
</div>
@if (productos is null)
{
    <Cargando />
}
else if (productos.Count == 0)
{
    <EstadoVacio Mensaje="No hay productos disponibles en el catálogo." />
}
else
{
    <AdminCard Titulo="Catálogo">
        <div class="table-responsive">
            <table class="admin-table">
                <thead><tr><th>Destacado</th><th>Producto</th><th>SKU</th><th>Precio</th></tr></thead>
                <tbody>
                    @foreach (var producto in productos)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input"
                                       checked="@Destacados.EstaDestacado(producto.ProductoId)"
                                       @onchange="() => Destacados.Alternar(producto.ProductoId)" />
                            </td>
                            <td>@producto.Nombre</td>
                            <td>@producto.SkuBase</td>
                            <td>@producto.PrecioBase.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </AdminCard>
}

@code {
    private List<ProductoDto>? productos;

    protected override async Task OnInitializedAsync()
    {
        var catalogo = await ProductoApi.ObtenerCatalogoAsync(tamanoPagina: 100);
        productos = catalogo?.Productos ?? new();
    }
}
