@page "/admin/productos/nuevo"
@page "/admin/productos/{Id:int}/editar"
@using System.ComponentModel.DataAnnotations

@inject IProductoApiClient ProductoApi
@inject NavigationManager NavigationManager

<PageTitle>@(Id is null ? "Nuevo producto" : "Editar producto")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@(Id is null ? "Nuevo producto" : "Editar producto")</h1>
        <p>Administra el producto desde la API.</p>
    </div>
    <a href="/admin/productos" class="btn btn-outline-dark"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

@if (!cargado)
{
    <Cargando />
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (Id is null && categorias.Count == 0)
    {
        <div class="alert alert-warning">Todavía no hay categorías. <a href="/admin/categorias">Crea una categoría</a> antes de agregar productos.</div>
    }
    else
    {
        <EditForm Model="producto" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <AdminCard Titulo="Información del producto">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="producto.Nombre" />
                    <ValidationMessage For="() => producto.Nombre" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label">SKU base</label>
                    <InputText class="form-control" @bind-Value="producto.SKU_Base" />
                    <ValidationMessage For="() => producto.SKU_Base" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <InputSelect class="form-select" @bind-Value="producto.CategoriaId">
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.CategoriaId">@categoria.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="producto.Descripcion" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Precio</label>
                    <InputNumber class="form-control" @bind-Value="producto.PrecioBase" min="0.01" step="0.01" />
                    <ValidationMessage For="() => producto.PrecioBase" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label">URL de imagen principal</label>
                    <InputText class="form-control" maxlength="255" @bind-Value="producto.ImagenUrl" />
                    <ValidationMessage For="() => producto.ImagenUrl" class="text-danger small" />
                    <div class="form-text">La URL puede tener hasta 255 caracteres.</div>
                </div>
                <button type="submit" class="btn btn-dark">Guardar producto</button>
            </AdminCard>
        </EditForm>

        @if (Id is not null)
        {
            <AdminCard Titulo="Variantes">
                @if (producto.Variantes.Count > 0)
                {
                    <div class="table-responsive mb-3">
                        <table class="admin-table">
                            <thead><tr><th>SKU</th><th>Talla</th><th>Color</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead>
                            <tbody>
                                @foreach (var variante in producto.Variantes)
                                {
                                    <tr>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="variante.SkuVariante" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="variante.Talla" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="variante.Color" /></td>
                                        <td>@variante.Stock</td>
                                        <td>
                                            <span>@(variante.Activo ? "Activa" : "Inactiva")</span>
                                        </td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => GuardarVariante(variante)">Guardar</button>
                                            @if (variante.Activo)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarVariante(variante)">Eliminar</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => CambiarEstadoVariante(variante)">Activar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="row g-2 align-items-end">
                    <div class="col"><label class="form-label">SKU de variante</label><input class="form-control" @bind="nuevaVariante.SKU_Variante" /></div>
                    <div class="col"><label class="form-label">Talla</label><input class="form-control" @bind="nuevaVariante.Talla" /></div>
                    <div class="col"><label class="form-label">Color</label><input class="form-control" @bind="nuevaVariante.Color" /></div>
                    <div class="col"><label class="form-label">Stock inicial</label><InputNumber class="form-control" @bind-Value="stockInicial" min="0" /></div>
                    <div class="col-auto"><button type="button" class="btn btn-outline-dark" @onclick="AgregarVariante">Agregar variante</button></div>
                </div>
            </AdminCard>

            <AdminCard Titulo="Imágenes adicionales">
                @if (producto.Imagenes.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        @foreach (var imagen in producto.Imagenes)
                        {
                            <div>
                                <img src="@imagen.UrlImagen" alt="Imagen adicional" class="admin-image-preview" />
                                <button type="button" class="btn btn-sm btn-outline-danger mt-1 w-100" @onclick="() => EliminarImagen(imagen)">
                                    Eliminar imagen
                                </button>
                            </div>
                        }
                    </div>
                }
                <div class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label">URL de imagen</label>
                        <input class="form-control" @bind="nuevaImagenUrl" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-outline-dark" @onclick="AgregarImagen">Agregar imagen</button>
                    </div>
                </div>
            </AdminCard>
        }
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool cargado;
    private string? error;
    private List<CategoriaDto> categorias = new();
    private ProductoEdicion producto = new();
    private CrearVarianteApiDto nuevaVariante = new();
    private int stockInicial;
    private string nuevaImagenUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        categorias = await ProductoApi.ObtenerCategoriasAsync();

        if (Id is int productoId)
        {
            var detalle = await ProductoApi.ObtenerProductoPorIdAsync(productoId);
            if (detalle is null)
            {
                error = "No se pudo cargar el producto.";
            }
            else
            {
                producto.Id = detalle.ProductoId;
                producto.Nombre = detalle.Nombre;
                producto.SKU_Base = detalle.SkuBase;
                producto.CategoriaId = detalle.CategoriaId;
                producto.Descripcion = detalle.Descripcion ?? string.Empty;
                producto.PrecioBase = detalle.PrecioBase;
                producto.ImagenUrl = detalle.ImagenUrl;
                producto.Variantes = await ProductoApi.ObtenerVariantesAsync(productoId);
                producto.Imagenes = detalle.Imagenes;
                nuevaVariante.ProductoId = productoId;
            }
        }
        else if (categorias.Count > 0)
        {
            producto.CategoriaId = categorias[0].CategoriaId;
        }

        cargado = true;
    }

    private async Task Guardar()
    {
        error = null;
        var dto = new CrearProductoDto
        {
            CategoriaId = producto.CategoriaId,
            SKU_Base = producto.SKU_Base,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            PrecioBase = producto.PrecioBase,
            UrlImagen = producto.ImagenUrl
        };

        var guardado = Id is int productoId
            ? await ProductoApi.ActualizarProductoAsync(productoId, dto)
            : await ProductoApi.CrearProductoAsync(dto);

        if (!guardado)
        {
            error = "No se pudo guardar el producto. Revisa los datos e inténtalo de nuevo.";
            return;
        }

        if (Id is null)
        {
            var catalogo = await ProductoApi.ObtenerCatalogoAsync(tamanoPagina: 100);
            var nuevoProducto = catalogo?.Productos.FirstOrDefault(p => p.SkuBase == producto.SKU_Base);
            if (nuevoProducto is null)
            {
                NavigationManager.NavigateTo("/admin/productos");
                return;
            }

            NavigationManager.NavigateTo($"/admin/productos/{nuevoProducto.ProductoId}/editar?creado=true");
        }
        else
        {
            error = "Producto guardado.";
        }
    }

    private async Task AgregarVariante()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(nuevaVariante.SKU_Variante))
        {
            error = "Ingresa el SKU de la variante.";
            return;
        }

        nuevaVariante.ProductoId = producto.Id;
        nuevaVariante.StockInicial = stockInicial;
        if (!await ProductoApi.CrearVarianteAsync(nuevaVariante))
        {
            error = "No se pudo crear la variante.";
            return;
        }

        producto.Variantes = await ProductoApi.ObtenerVariantesAsync(producto.Id);
        nuevaVariante = new CrearVarianteApiDto { ProductoId = producto.Id };
        stockInicial = 0;
    }

    private async Task GuardarVariante(VarianteDto variante)
    {
        error = null;
        var actualizado = await ProductoApi.ActualizarVarianteAsync(variante.VarianteId, new CrearVarianteApiDto
        {
            ProductoId = producto.Id,
            SKU_Variante = variante.SkuVariante,
            Talla = variante.Talla,
            Color = variante.Color
        });
        if (!actualizado)
        {
            error = "No se pudo actualizar la variante.";
            return;
        }

        producto.Variantes = await ProductoApi.ObtenerVariantesAsync(producto.Id);
    }

    private async Task EliminarVariante(VarianteDto variante)
    {
        error = null;
        if (!await ProductoApi.EliminarVarianteAsync(variante.VarianteId))
        {
            error = "No se pudo desactivar la variante.";
            return;
        }

        producto.Variantes = await ProductoApi.ObtenerVariantesAsync(producto.Id);
    }

    private async Task CambiarEstadoVariante(VarianteDto variante)
    {
        error = null;
        if (!await ProductoApi.CambiarEstadoVarianteAsync(variante.VarianteId))
        {
            error = "No se pudo activar la variante.";
            return;
        }

        producto.Variantes = await ProductoApi.ObtenerVariantesAsync(producto.Id);
    }

    private async Task AgregarImagen()
    {
        if (string.IsNullOrWhiteSpace(nuevaImagenUrl))
        {
            error = "Ingresa la URL de la imagen.";
            return;
        }

        var imagen = new AgregarImagenApiDto
        {
            ProductoId = producto.Id,
            UrlImagen = nuevaImagenUrl,
            Orden = producto.Imagenes.Count == 0 ? 1 : producto.Imagenes.Max(i => i.Orden) + 1
        };

        if (!await ProductoApi.AgregarImagenAsync(imagen))
        {
            error = "No se pudo agregar la imagen.";
            return;
        }

        var detalle = await ProductoApi.ObtenerProductoPorIdAsync(producto.Id);
        producto.Imagenes = detalle?.Imagenes ?? new();
        nuevaImagenUrl = string.Empty;
    }

    private async Task EliminarImagen(ImagenDto imagen)
    {
        if (!await ProductoApi.EliminarImagenAsync(imagen.ImagenId))
        {
            error = "No se pudo eliminar la imagen.";
            return;
        }

        producto.Imagenes.Remove(imagen);
    }

    private sealed class ProductoEdicion
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Ingresa el nombre del producto.")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa el SKU base.")]
        public string SKU_Base { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Selecciona una categoría.")]
        public int CategoriaId { get; set; }

        public string Descripcion { get; set; } = string.Empty;

        [Range(0.01, double.MaxValue, ErrorMessage = "El precio debe ser mayor a cero.")]
        public decimal PrecioBase { get; set; }

        [StringLength(255, ErrorMessage = "La URL de imagen no puede exceder los 255 caracteres.")]
        public string ImagenUrl { get; set; } = string.Empty;
        public List<VarianteDto> Variantes { get; set; } = new();
        public List<ImagenDto> Imagenes { get; set; } = new();
    }
}
