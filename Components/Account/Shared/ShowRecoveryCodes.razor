<div class="account-card">
    <div class="account-card-header">
        <div class="account-card-icon"><IconoSvg Nombre="llave" Width="20" Height="20" /></div>
        <div>
            <h2 class="account-card-title">Códigos de recuperación</h2>
            <p class="account-card-subtitle">Guarda estos códigos en un lugar seguro: cada uno solo se puede usar una vez.</p>
        </div>
    </div>
    <div class="account-card-body">
        <StatusMessage Message="@StatusMessage" />
        <div class="alert alert-warning" role="alert">
            <p>
                <strong>Guarda estos códigos en un lugar seguro.</strong>
            </p>
            <p>
                Si pierdes tu dispositivo y no tienes los códigos de recuperación, perderás el acceso a tu cuenta.
            </p>
        </div>
        <div class="row">
            <div class="col-md-12">
                @foreach (var recoveryCode in RecoveryCodes)
                {
                    <div>
                        <code class="recovery-code">@recoveryCode</code>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
