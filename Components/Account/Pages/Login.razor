@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using VoltajeModa.HttpServices

@inject IProductoApiClient ProductoApi
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · Voltaje Moda</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-kicker">Voltaje Moda</span>
            <h1>Bienvenido de nuevo</h1>
            <p class="auth-subtitle">Ingresa con tu correo y contraseña para continuar.</p>
        </div>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="IniciarSesion" FormName="login">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username webauthn" aria-required="true"/>
                <label for="Input.Email">Correo electrónico</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>

            <div class="form-floating mb-2 auth-password-field">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true"/>
                <label for="Input.Password">Contraseña</label>
                <button type="button" class="auth-password-toggle" data-toggle-password="Input.Password" aria-pressed="false" aria-label="Mostrar u ocultar la contraseña">Mostrar</button>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-dark btn-lg auth-submit">Iniciar sesión</button>
        </EditForm>

        <p class="auth-footer-text">
            ¿No tienes cuenta?
            <a href="/Account/Register">Regístrate</a>
        </p>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task IniciarSesion()
    {
        errorMessage = null;
        var inicioExitoso = await ProductoApi.IniciarSesionAsync(Input.Email, Input.Password);
        if (inicioExitoso)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            errorMessage = "Correo o contraseña incorrectos. Inténtalo de nuevo.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Ingresa tu correo electrónico.")]
        [EmailAddress(ErrorMessage = "Ingresa un correo electrónico válido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Ingresa tu contraseña.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
