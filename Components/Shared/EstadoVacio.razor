<div class="empty-state">
    <IconoSvg Nombre="caja-vacia" Width="40" Height="40" CssClass="empty-state-icon" />
    <p class="empty-state-message">@Mensaje</p>
    @if (EnlaceHref is not null)
    {
        <a href="@EnlaceHref" class="btn btn-outline-dark btn-sm">@EnlaceTexto</a>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Mensaje { get; set; } = default!;

    [Parameter]
    public string? EnlaceTexto { get; set; }

    [Parameter]
    public string? EnlaceHref { get; set; }
}
