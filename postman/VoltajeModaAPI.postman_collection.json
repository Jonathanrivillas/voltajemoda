                  "pm.test('El carrito contiene la variante agregada', () => {",
                  "    const varianteId = parseInt(pm.collectionVariables.get('productoVarianteId'));",
                  "    const item = body.items.find(i => i.productoVarianteId === varianteId);",
                  "    pm.expect(item).to.not.be.undefined;",
                  "    pm.expect(item.cantidad).to.equal(1);",
                  "});"
