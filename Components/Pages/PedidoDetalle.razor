@page "/pedidos/{Id:int}"

@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@using VoltajeModa.Services

@inject IProductoApiClient ProductoApi
@inject SesionUsuarioService Sesion

<PageTitle>Pedido #@Id</PageTitle>

<div class="account-shell">
    @if (!cargado)
    {
        <Cargando />
    }
    else if (pedido is null)
    {
        <EstadoVacio Mensaje="No se encontró el pedido o no tienes permiso para consultarlo." />
    }
    else
    {
        <div class="account-card">
            <div class="account-card-header">
                <div class="account-card-icon"><IconoSvg Nombre="caja" Width="20" Height="20" /></div>
                <div>
                    <h2 class="account-card-title">Pedido #@pedido.PedidoId</h2>
                    <p class="account-card-subtitle">@pedido.FechaPedido.ToLocalTime().ToString("g")</p>
                </div>
            </div>
            <div class="account-card-body">
                <a href="/Account/Manage/MisPedidos" class="btn btn-sm btn-outline-dark mb-3">&larr; Volver a mis pedidos</a>
                <p><span class="account-badge account-badge-@pedido.Estado.ToLowerInvariant()">@pedido.Estado</span></p>
                <p>Enviar a: @pedido.DireccionEnvio, @pedido.CiudadEnvio</p>
                <p>Método de pago: @pedido.MetodoPago</p>

                <table class="table">
                    <thead><tr><th>Producto</th><th>Talla / Color</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var item in pedido.Detalles)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.Talla / @item.Color</td>
                                <td>@item.Cantidad</td>
                                <td>@item.PrecioUnitario.ToString("C")</td>
                                <td>@item.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <h4 class="text-end">Total: @pedido.Total.ToString("C")</h4>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool cargado;
    private PedidoClienteDto? pedido;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.Rol == "Cliente")
        {
            pedido = await ProductoApi.ObtenerMiPedidoAsync(Id);
        }

        cargado = true;
    }
}
