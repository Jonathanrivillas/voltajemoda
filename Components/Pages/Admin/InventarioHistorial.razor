@page "/admin/inventario/historial"

@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos

@inject IProductoApiClient ProductoApi

<PageTitle>Historial de inventario</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Historial de movimientos de stock</h1>
        <p>Entradas, salidas y ajustes registrados por variante.</p>
    </div>
    <a href="/admin/inventario" class="btn btn-outline-dark"><i class="bi bi-arrow-left"></i> Volver a Inventario</a>
</div>

@if (movimientos is null)
{
    <Cargando />
}
else if (movimientos.Count == 0)
{
    <EstadoVacio Mensaje="No hay movimientos de inventario registrados." />
}
else
{
    <AdminCard>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr><th>Fecha</th><th>Producto</th><th>SKU variante</th><th>Tipo</th><th>Cantidad</th><th>Motivo</th><th>Empleado</th></tr>
                </thead>
                <tbody>
                    @foreach (var movimiento in movimientos)
                    {
                        <tr>
                            <td>@movimiento.FechaAjuste.ToLocalTime().ToString("g")</td>
                            <td>@movimiento.NombreProducto</td>
                            <td>@movimiento.SKU_Variante</td>
                            <td>@(movimiento.CantidadAjuste >= 0 ? "Entrada" : "Salida")</td>
                            <td>@movimiento.CantidadAjuste</td>
                            <td>@movimiento.Motivo</td>
                            <td>@movimiento.NombreEmpleado</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </AdminCard>
}

@code {
    private List<HistorialInventarioDto>? movimientos;

    protected override async Task OnInitializedAsync()
    {
        movimientos = await ProductoApi.ObtenerHistorialInventarioAsync();
    }
}
