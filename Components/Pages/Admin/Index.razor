@page "/admin"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@inject IProductoApiClient ProductoApi

<PageTitle>Panel de administración</PageTitle>
<div class="admin-page-header">
    <div><h1>Panel de administración</h1><p>@DateTime.Now.ToString("dddd d 'de' MMMM 'de' yyyy")</p></div>
</div>
@if (resumen is null)
{
    <Cargando />
}
else
{
    <div class="admin-stats-row">
        <AdminStatCard Titulo="Productos" Valor="@resumen.TotalProductos.ToString()" Icono="bi-box-seam" />
        <AdminStatCard Titulo="Productos activos" Valor="@resumen.ProductosActivos.ToString()" Icono="bi-check-circle" />
        <AdminStatCard Titulo="Clientes" Valor="@resumen.TotalClientes.ToString()" Icono="bi-people" />
        <AdminStatCard Titulo="Pedidos pendientes" Valor="@resumen.PedidosPendientes.ToString()" Icono="bi-hourglass-split" />
        <AdminStatCard Titulo="Pedidos hoy" Valor="@resumen.VentasHoy.ToString()" Icono="bi-bag-check" />
        <AdminStatCard Titulo="Ingresos del mes" Valor="@resumen.IngresosMes.ToString("C")" Icono="bi-graph-up-arrow" />
        <AdminStatCard Titulo="Variantes con stock bajo" Valor="@resumen.StockBajo.ToString()" Icono="bi-exclamation-triangle" />
    </div>
    <AdminCard Titulo="Pedidos recientes">
        @if (resumen.UltimosPedidos.Count == 0)
        {
            <EstadoVacio Mensaje="Todavía no hay pedidos." />
        }
        else
        {
            @foreach (var pedido in resumen.UltimosPedidos)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div><a href="/admin/pedidos/@pedido.PedidoId">#@pedido.PedidoId — @pedido.Cliente</a><div class="text-muted small">@pedido.Correo</div></div>
                    <div class="text-end"><div>@pedido.Total.ToString("C")</div><div>@pedido.Estado</div></div>
                </div>
            }
        }
    </AdminCard>
}
@code {
    private DashboardAdminDto? resumen;
    protected override async Task OnInitializedAsync() => resumen = await ProductoApi.ObtenerDashboardAdminAsync();
}
