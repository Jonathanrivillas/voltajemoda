@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using VoltajeModa.Data
@using VoltajeModa.Models
@using VoltajeModa.Services

@inject ApplicationDbContext Db
@inject CarritoService CarritoService
@inject CarritoEstadoService CarritoEstado
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<div class="offcanvas offcanvas-end carrito-drawer" tabindex="-1" id="carritoDrawer" aria-labelledby="carritoDrawerLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="carritoDrawerLabel">Tu carrito</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        @if (!cargado)
        {
            <Cargando />
        }
        else if (items is null || items.Count == 0)
        {
            <EstadoVacio Mensaje="Tu carrito de compras está vacío." EnlaceTexto="Explorar productos" EnlaceHref="/productos" />
        }
        else
        {
            <div class="carrito-drawer-items">
                @foreach (var item in items)
                {
                    <div class="carrito-drawer-item">
                        <img src="@item.ProductoVariante!.Producto!.ImagenUrl" alt="@item.ProductoVariante.Producto.Nombre" class="carrito-drawer-item-img" />
                        <div class="carrito-drawer-item-info">
                            <p class="carrito-drawer-item-nombre">@item.ProductoVariante.Producto.Nombre</p>
                            <p class="carrito-drawer-item-variante">@item.ProductoVariante.Talla / @item.ProductoVariante.Color</p>
                            <div class="carrito-drawer-item-footer">
                                <input type="number" class="form-control form-control-sm" min="1" style="width: 64px;" value="@item.Cantidad"
                                       @onchange="@(e => ActualizarCantidad(item.Id, e.Value))" />
                                <span class="carrito-drawer-item-precio">@((item.ProductoVariante.Producto.PrecioEfectivo * item.Cantidad).ToString("C"))</span>
                            </div>
                        </div>
                        <button type="button" class="carrito-drawer-item-quitar" aria-label="Quitar" @onclick="() => EliminarItem(item.Id)">
                            &times;
                        </button>
                    </div>
                }
            </div>

            <div class="carrito-drawer-footer mt-auto">
                <div class="carrito-drawer-total">
                    <span>Total</span>
                    <span>@total.ToString("C")</span>
                </div>
                <a href="/checkout" class="btn btn-dark w-100" data-bs-dismiss="offcanvas">Proceder al pago</a>
                <a href="/carrito" class="btn btn-link w-100" data-bs-dismiss="offcanvas">Ver carrito completo</a>
            </div>
        }
    </div>
</div>

@code {
    private bool cargado;
    private int? carritoId;
    private List<CarritoItem>? items;
    private decimal total;

    public async Task AbrirAsync()
    {
        await CargarAsync();

        // Sin este StateHasChanged, el render con los items recién cargados se despacha recién
        // cuando termina este método (al volver del @onclick en NavMenu), lo que puede llegar
        // después de que el JS ya haya mostrado el offcanvas -> se ve vacío un instante.
        StateHasChanged();

        await JS.InvokeVoidAsync("carritoUi.abrir", "carritoDrawer");
    }

    private async Task CargarAsync()
    {
        cargado = false;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usuarioId = authState.User.Identity?.IsAuthenticated == true
            ? authState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            : null;

        var carrito = await CarritoService.ObtenerOCrearCarritoAsync(usuarioId);
        carritoId = carrito.Id;

        items = await Db.CarritoItems
            .Where(i => i.CarritoId == carritoId)
            .Include(i => i.ProductoVariante)
                .ThenInclude(v => v!.Producto)
            .ToListAsync();

        total = items.Sum(i => i.ProductoVariante!.Producto!.PrecioEfectivo * i.Cantidad);
        cargado = true;
    }

    private async Task ActualizarCantidad(int itemId, object? valor)
    {
        if (int.TryParse(valor?.ToString(), out var nuevaCantidad) && nuevaCantidad >= 1)
        {
            var itemDb = await Db.CarritoItems.FindAsync(itemId);
            if (itemDb is not null)
            {
                itemDb.Cantidad = nuevaCantidad;
                await Db.SaveChangesAsync();
            }
        }

        await CargarAsync();
        CarritoEstado.Notificar();
    }

    private async Task EliminarItem(int itemId)
    {
        var itemDb = await Db.CarritoItems.FindAsync(itemId);
        if (itemDb is not null)
        {
            Db.CarritoItems.Remove(itemDb);
            await Db.SaveChangesAsync();
        }

        await CargarAsync();
        CarritoEstado.Notificar();
    }
}
