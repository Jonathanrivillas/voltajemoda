@page "/admin/estadisticas"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@inject IProductoApiClient ProductoApi

<PageTitle>Estadísticas</PageTitle>
<div class="admin-page-header"><div><h1>Estadísticas</h1><p>Resumen de ventas y productos desde la API.</p></div></div>
@if (estadisticas is null)
{
    <Cargando />
}
else
{
    <div class="admin-stats-row">
        <AdminStatCard Titulo="Ventas del mes" Valor="@estadisticas.TotalVentasMes.ToString()" Icono="bi-bag-check" />
        <AdminStatCard Titulo="Ingresos del mes" Valor="@estadisticas.IngresosMes.ToString("C")" Icono="bi-cash-coin" />
        <AdminStatCard Titulo="Promedio por pedido" Valor="@estadisticas.PromedioPedido.ToString("C")" Icono="bi-graph-up" />
        <AdminStatCard Titulo="Clientes activos" Valor="@estadisticas.ClientesActivos.ToString()" Icono="bi-people" />
    </div>
    <div class="admin-grid-2">
        <AdminCard Titulo="Ventas por día">
            @foreach (var venta in estadisticas.VentasPorDia)
            {
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span>@venta.Fecha.ToLocalTime().ToString("d")</span>
                    <span>@venta.TotalVentas pedidos · @venta.Ingresos.ToString("C")</span>
                </div>
            }
        </AdminCard>
        <AdminCard Titulo="Productos más vendidos">
            @foreach (var producto in estadisticas.ProductosMasVendidos)
            {
                <div class="d-flex justify-content-between py-2 border-bottom"><span>@producto.Nombre</span><strong>@producto.UnidadesVendidas unidades</strong></div>
            }
        </AdminCard>
    </div>
}
@code {
    private EstadisticasAdminDto? estadisticas;
    protected override async Task OnInitializedAsync() => estadisticas = await ProductoApi.ObtenerEstadisticasAdminAsync();
}
