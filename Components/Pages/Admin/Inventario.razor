@page "/admin/inventario"

@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos

@inject IProductoApiClient ProductoApi

<PageTitle>Inventario</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Inventario</h1>
        <p>Controla el stock por variante y registra ajustes.</p>
    </div>
    <a href="/admin/inventario/historial" class="btn btn-outline-dark"><i class="bi bi-clock-history"></i> Ver historial</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
@if (mensaje is not null)
{
    <div class="alert alert-success">@mensaje</div>
}

<div class="admin-stats-row mb-3">
    <AdminStatCard Titulo="Variantes" Valor="@(resumen?.TotalVariantes.ToString() ?? "—")" Icono="bi-boxes" />
    <AdminStatCard Titulo="Unidades en stock" Valor="@(resumen?.TotalStock.ToString() ?? "—")" Icono="bi-box-seam" />
    <AdminStatCard Titulo="Variantes agotadas" Valor="@(resumen?.VariantesSinStock.ToString() ?? "—")" Icono="bi-exclamation-triangle" />
</div>

@if (items is null)
{
    <Cargando />
}
else
{
    <AdminCard>
        <Toolbar>
            <div class="admin-filter-bar">
                <input class="form-control form-control-sm" placeholder="Buscar producto..." @bind="busqueda" @bind:event="oninput" />
                <select class="form-select form-select-sm" @bind="categoriaId">
                    <option value="0">Todas las categorías</option>
                    @foreach (var categoria in categorias)
                    {
                        <option value="@categoria.CategoriaId">@categoria.Nombre</option>
                    }
                </select>
                <select class="form-select form-select-sm" @bind="estadoFiltro">
                    <option value="Todos">Todos los estados</option>
                    <option value="EnStock">En stock</option>
                    <option value="StockBajo">Stock bajo</option>
                    <option value="SinStock">Sin stock</option>
                </select>
            </div>
        </Toolbar>
        <ChildContent>
            @if (VariantesFiltradas.Count == 0)
            {
                <EstadoVacio Mensaje="No hay variantes que coincidan con los filtros." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr><th>Producto</th><th>Talla</th><th>Color</th><th>SKU</th><th>Stock</th><th>Ajuste</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in VariantesFiltradas)
                            {
                                <tr>
                                    <td>@item.Producto.Nombre</td>
                                    <td>@item.Variante.Talla</td>
                                    <td>@item.Variante.Color</td>
                                    <td>@item.Variante.SkuVariante</td>
                                    <td><StockBadge Stock="item.Variante.Stock" /></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <InputNumber class="form-control form-control-sm" min="1" @bind-Value="cantidadAjuste" />
                                            <button class="btn btn-sm btn-outline-dark" @onclick="() => AjustarStock(item, true)">Entrada</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => AjustarStock(item, false)">Salida</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </AdminCard>
}

@code {
    private List<InventarioFila>? items;
    private List<CategoriaDto> categorias = new();
    private ResumenInventarioDto? resumen;
    private string busqueda = string.Empty;
    private int categoriaId;
    private string estadoFiltro = "Todos";
    private int cantidadAjuste = 1;
    private string? error;
    private string? mensaje;

    private List<InventarioFila> VariantesFiltradas
    {
        get
        {
            if (items is null)
                return new();

            if (categoriaId == 0 && estadoFiltro == "Todos" && string.IsNullOrWhiteSpace(busqueda))
                return items;

            return items
                .Where(x => categoriaId == 0 || x.Producto.CategoriaId == categoriaId)
                .Where(x => string.IsNullOrWhiteSpace(busqueda) || (x.Producto.Nombre ?? string.Empty).Contains(busqueda, StringComparison.OrdinalIgnoreCase))
                .Where(x => estadoFiltro switch
                {
                    "EnStock" => x.Variante.Stock > 5,
                    "StockBajo" => x.Variante.Stock is > 0 and <= 5,
                    "SinStock" => x.Variante.Stock == 0,
                    _ => true
                })
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        categorias = await ProductoApi.ObtenerCategoriasAsync();
        resumen = await ProductoApi.ObtenerResumenInventarioAsync();
        await CargarVariantesAsync();
    }

    private async Task CargarVariantesAsync()
    {
        var catalogo = await ProductoApi.ObtenerCatalogoAsync(tamanoPagina: 100);
        if (catalogo is null)
        {
            items = new();
            error = "No se pudo cargar el catálogo de productos.";
            return;
        }

        var detalles = await Task.WhenAll(catalogo.Productos.Select(p => ProductoApi.ObtenerProductoPorIdAsync(p.ProductoId)));
        items = detalles
            .Where(p => p is not null)
            .SelectMany(p => p!.Variantes.Select(v => new InventarioFila(p, v)))
            .ToList();
    }

    private async Task AjustarStock(InventarioFila item, bool entrada)
    {
        error = null;
        mensaje = null;
        if (cantidadAjuste <= 0)
        {
            error = "La cantidad debe ser mayor que cero.";
            return;
        }

        var cantidad = entrada ? cantidadAjuste : -cantidadAjuste;
        if (!await ProductoApi.AjustarInventarioAsync(item.Variante.VarianteId, cantidad, "Ajuste manual desde panel"))
        {
            error = "No se pudo ajustar el inventario. Verifica tus permisos y el stock disponible.";
            return;
        }

        var stockAnterior = item.Variante.Stock;
        item.Variante.Stock += cantidad;
        mensaje = $"Inventario actualizado para {item.Producto.Nombre}.";
        var resumenActualizado = await ProductoApi.ObtenerResumenInventarioAsync();
        if (resumenActualizado is not null)
        {
            resumen = resumenActualizado;
        }
        else if (resumen is not null)
        {
            resumen.TotalStock += cantidad;
            if (stockAnterior == 0 && item.Variante.Stock > 0)
                resumen.VariantesSinStock = Math.Max(0, resumen.VariantesSinStock - 1);
            else if (stockAnterior > 0 && item.Variante.Stock == 0)
                resumen.VariantesSinStock++;
        }
    }

    private sealed record InventarioFila(ProductoDetalleDto Producto, VarianteDto Variante);
}
