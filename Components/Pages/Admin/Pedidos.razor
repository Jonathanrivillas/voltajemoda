@page "/admin/pedidos"
@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@inject IProductoApiClient ProductoApi

<PageTitle>Pedidos</PageTitle>
<div class="admin-page-header">
    <div><h1>Pedidos</h1><p>Consulta y actualiza el estado de los pedidos.</p></div>
</div>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
@if (pedidos is null)
{
    <Cargando />
}
else if (pedidos.Count == 0)
{
    <EstadoVacio Mensaje="Todavía no hay pedidos." />
}
else
{
    <AdminCard>
        <div class="table-responsive">
            <table class="admin-table">
                <thead><tr><th>Fecha</th><th>Cliente</th><th>Ciudad</th><th>Total</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var pedido in pedidos)
                    {
                        <tr>
                            <td>@pedido.FechaPedido?.ToLocalTime().ToString("g")</td>
                            <td>@pedido.Cliente</td>
                            <td>@pedido.CiudadEnvio</td>
                            <td>@pedido.Total.ToString("C")</td>
                            <td>
                                <select class="form-select form-select-sm" @bind="pedido.Estado" @bind:after="() => GuardarEstado(pedido)">
                                    @foreach (var estado in estados) { <option value="@estado">@estado</option> }
                                </select>
                            </td>
                            <td><a href="/admin/pedidos/@pedido.PedidoId" class="btn btn-sm btn-outline-dark">Ver detalle</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </AdminCard>
}
@code {
    private readonly string[] estados = ["Pendiente", "EnPreparacion", "Enviado", "Entregado", "Cancelado"];
    private List<PedidoAdminResumenDto>? pedidos;
    private string? error;

    protected override async Task OnInitializedAsync() => pedidos = await ProductoApi.ObtenerPedidosAdminAsync();

    private async Task GuardarEstado(PedidoAdminResumenDto pedido)
    {
        error = await ProductoApi.CambiarEstadoPedidoAsync(pedido.PedidoId, pedido.Estado)
            ? null
            : "No se pudo actualizar el estado del pedido.";
    }
}
