@using VoltajeModa.HttpServices
@using VoltajeModa.HttpServices.Dtos
@using VoltajeModa.Services

@inject IProductoApiClient ProductoApi
@inject CarritoEstadoService CarritoEstado
@inject SesionUsuarioService Sesion
@inject IJSRuntime JS

<div class="offcanvas offcanvas-end carrito-drawer" tabindex="-1" id="carritoDrawer" aria-labelledby="carritoDrawerLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="carritoDrawerLabel">Tu carrito</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        @if (!cargado)
        {
            <Cargando />
        }
        else if (items.Count == 0)
        {
            <EstadoVacio Mensaje="@(Sesion.EstaAutenticado ? "Tu carrito de compras está vacío." : "Inicia sesión para consultar tu carrito.")"
                        EnlaceTexto="@(Sesion.EstaAutenticado ? "Explorar productos" : "Ingresar")"
                        EnlaceHref="@(Sesion.EstaAutenticado ? "/productos" : "/Account/Login")" />
        }
        else
        {
            <div class="carrito-drawer-items">
                @foreach (var item in items)
                {
                    <div class="carrito-drawer-item">
                        <div class="carrito-drawer-item-info">
                            <p class="carrito-drawer-item-nombre">@item.NombreProducto</p>
                            <p class="carrito-drawer-item-variante">@item.Talla / @item.Color</p>
                            <div class="carrito-drawer-item-footer">
                                <input type="number" class="form-control form-control-sm" min="1" style="width: 64px;" value="@item.Cantidad"
                                       @onchange="@(e => ActualizarCantidad(item.CarritoItemId, e.Value))" />
                                <span class="carrito-drawer-item-precio">@item.Subtotal.ToString("C")</span>
                            </div>
                        </div>
                        <button type="button" class="carrito-drawer-item-quitar" aria-label="Quitar" @onclick="() => EliminarItem(item.CarritoItemId)">
                            &times;
                        </button>
                    </div>
                }
            </div>

            <div class="carrito-drawer-footer mt-auto">
                <div class="carrito-drawer-total">
                    <span>Total</span>
                    <span>@total.ToString("C")</span>
                </div>
                <a href="/carrito" class="btn btn-dark w-100" data-bs-dismiss="offcanvas">Proceder al pago</a>
                <a href="/carrito" class="btn btn-link w-100" data-bs-dismiss="offcanvas">Ver carrito completo</a>
            </div>
        }
    </div>
</div>

@code {
    private bool cargado;
    private List<CarritoItemDto> items = new();
    private decimal total;

    public async Task AbrirAsync()
    {
        await CargarAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("carritoUi.abrir", "carritoDrawer");
    }

    private async Task CargarAsync()
    {
        cargado = false;
        var carrito = Sesion.Rol == "Cliente" ? await ProductoApi.ObtenerCarritoAsync() : null;
        items = carrito?.Items ?? new();
        total = carrito?.Total ?? 0;
        cargado = true;
    }

    private async Task ActualizarCantidad(int itemId, object? valor)
    {
        if (int.TryParse(valor?.ToString(), out var nuevaCantidad) && nuevaCantidad >= 1
            && await ProductoApi.ActualizarCantidadCarritoAsync(itemId, nuevaCantidad))
        {
            await CargarAsync();
            CarritoEstado.Notificar();
        }
    }

    private async Task EliminarItem(int itemId)
    {
        if (await ProductoApi.EliminarItemCarritoAsync(itemId))
        {
            await CargarAsync();
            CarritoEstado.Notificar();
        }
    }
}
