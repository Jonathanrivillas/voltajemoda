@inherits LayoutComponentBase
@implements IDisposable

@using VoltajeModa.Services

@inject NavigationManager NavigationManager
@inject SesionUsuarioService Sesion

@* Chart.js/admin-charts.js/admin-ui.js se cargan desde App.razor (no desde acá): con la navegación
   "enhanced" de Blazor, un <script> agregado dinámicamente vía <HeadContent> del layout no bloquea
   ni garantiza estar listo cuando OnAfterRenderAsync intenta usarlo — causaba una carrera que
   tumbaba el circuito entero. App.razor es el shell raíz, siempre presente antes de que corra
   cualquier componente interactivo. *@
@if (!EsPersonalAutorizado)
{
    <Cargando />
}
else
{
<HeadContent>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["admin.css"]" />
</HeadContent>

<div class="admin-shell @(sidebarAbierto ? "admin-shell--abierta" : "")">
    <div class="admin-sidebar-backdrop" @onclick="CerrarSidebar"></div>

    <aside class="admin-sidebar">
        <a class="admin-sidebar__brand" href="admin">VOLTAJE <span>Admin</span></a>

        <nav class="admin-sidebar__nav">
            <NavLink class="admin-nav-link" href="admin" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2"></i> <span>Panel</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/banner">
                <i class="bi bi-images"></i> <span>Banner</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/productos">
                <i class="bi bi-box-seam"></i> <span>Productos</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/categorias">
                <i class="bi bi-tags"></i> <span>Categorías</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/inventario">
                <i class="bi bi-clipboard-data"></i> <span>Inventario</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/pedidos">
                <i class="bi bi-receipt"></i> <span>Pedidos</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/estadisticas">
                <i class="bi bi-graph-up"></i> <span>Estadísticas</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/usuarios">
                <i class="bi bi-people"></i> <span>Usuarios</span>
            </NavLink>
            <NavLink class="admin-nav-link" href="admin/cupones">
                <i class="bi bi-ticket-perforated"></i> <span>Cupones</span>
            </NavLink>
        </nav>

        <a class="admin-nav-link admin-nav-link--muted" href="/">
            <i class="bi bi-box-arrow-left"></i> <span>Volver al sitio</span>
        </a>
    </aside>

    <div class="admin-content">
        <header class="admin-topbar">
            <button class="admin-topbar__toggle" @onclick="AlternarSidebar" aria-label="Mostrar/ocultar menú">
                <i class="bi bi-list"></i>
            </button>

            <div class="admin-topbar__search">
                <i class="bi bi-search"></i>
                <input type="search" placeholder="Buscar en el panel..." disabled />
            </div>

            <div class="admin-topbar__actions">
                <div class="dropdown">
                    <button class="admin-user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="admin-user-avatar">@(Sesion.Correo?.Trim().Substring(0, 1).ToUpperInvariant() ?? "?")</span>
                        <span class="admin-user-name">@Sesion.Correo</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text">@Sesion.Rol</span></li>
                        <li><NavLink class="dropdown-item" href="/">Volver al sitio</NavLink></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><button type="button" class="dropdown-item" @onclick="CerrarSesionAsync">Cerrar sesión</button></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="admin-main">
            @Body
        </main>
    </div>
</div>
}

@code {
    private bool sidebarAbierto;
    private bool redireccionEnviada;
    private bool EsPersonalAutorizado => Sesion.EstaAutenticado && Sesion.Rol is ("Administrador" or "Empleado");

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        Sesion.OnChange += OnSesionCambio;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!Sesion.Inicializada)
        {
            return;
        }

        if (!EsPersonalAutorizado && !redireccionEnviada)
        {
            redireccionEnviada = true;
            NavigationManager.NavigateTo("/Account/Login");
        }
    }

    private void AlternarSidebar() => sidebarAbierto = !sidebarAbierto;

    private void CerrarSidebar() => sidebarAbierto = false;

    private async Task CerrarSesionAsync()
    {
        await Sesion.CerrarSesionAsync();
        NavigationManager.NavigateTo("/Account/Login");
    }

    private void OnSesionCambio()
    {
        _ = InvokeAsync(() =>
        {
            if (!EsPersonalAutorizado)
            {
                redireccionEnviada = true;
                NavigationManager.NavigateTo("/Account/Login");
            }

            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        sidebarAbierto = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Sesion.OnChange -= OnSesionCambio;
    }
}
