@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using VoltajeModa.Data
@using VoltajeModa.Models

@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<div class="promo-bar" id="promoBar">Suscríbete y obtén el 15%DTO. en tu primera compra</div>

<nav class="navbar navbar-expand-lg voltaje-navbar sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand voltaje-brand" href="/">VOLTAJE</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
                aria-controls="navbarMenu" aria-expanded="false" aria-label="Mostrar/ocultar menú">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0 voltaje-nav-links">
                @foreach (var categoria in categorias)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"productos?categoriaId={categoria.Id}")">@categoria.Nombre</NavLink>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <form action="/productos" method="get" class="voltaje-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                        <path d="m21 21-4.34-4.34" />
                        <circle cx="11" cy="11" r="8" />
                    </svg>
                    <input type="search" name="buscar" class="form-control form-control-sm" placeholder="Buscar" aria-label="Buscar productos" />
                </form>

                <div class="dropdown">
                    <button class="voltaje-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Cuenta">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                        <AuthorizeView>
                            <Authorized>
                                <li class="user-dropdown-header">
                                    <div class="account-avatar">@iniciales</div>
                                    <div class="user-dropdown-info">
                                        <div class="user-dropdown-name">@(nombre ?? context.User.Identity?.Name)</div>
                                        <div class="user-dropdown-email">@correo</div>
                                    </div>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item user-dropdown-link" href="Account/Manage">
                                        <IconoSvg Nombre="usuario" />
                                        <span>Mi cuenta</span>
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item user-dropdown-link" href="mis-pedidos">
                                        <IconoSvg Nombre="caja" />
                                        <span>Mis pedidos</span>
                                    </NavLink>
                                </li>
                                <AuthorizeView Roles="Administrador" Context="adminContext">
                                    <Authorized>
                                        <li>
                                            <NavLink class="dropdown-item user-dropdown-link" href="admin">
                                                <IconoSvg Nombre="panel" />
                                                <span>Admin</span>
                                            </NavLink>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form action="Account/Logout" method="post">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                        <button type="submit" class="dropdown-item user-dropdown-link user-dropdown-logout">
                                            <IconoSvg Nombre="salir" />
                                            <span>Salir</span>
                                        </button>
                                    </form>
                                </li>
                            </Authorized>
                            <NotAuthorized>
                                <li><NavLink class="dropdown-item user-dropdown-link" href="Account/Login">Ingresar</NavLink></li>
                                <li><NavLink class="dropdown-item user-dropdown-link" href="Account/Register">Registrarse</NavLink></li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>

                <a class="voltaje-icon-btn" href="carrito" aria-label="Carrito">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                        <path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18" />
                        <path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25" />
                        <circle cx="18" cy="20" r="2" />
                        <circle cx="8" cy="20" r="2" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;
    private List<Categoria> categorias = new();
    private string? nombre;
    private string? correo;
    private string iniciales = "?";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categorias = await db.Categorias.ToListAsync();

        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
                var usuario = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);
                if (usuario is not null)
                {
                    nombre = string.IsNullOrWhiteSpace(usuario.Nombre) ? null : usuario.Nombre;
                    correo = usuario.Email;
                    iniciales = AvatarUtils.CalcularIniciales(nombre ?? correo);
                }
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
