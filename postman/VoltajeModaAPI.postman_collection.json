      "name": "1. Flujo invitado - compra completa",
      "item": [
        {
          "name": "1.1 Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve al menos un producto', () => pm.expect(body.items.length).to.be.above(0));",
                  "pm.collectionVariables.set('productoId', body.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/productos", "host": ["{{baseUrl}}"], "path": ["api", "productos"] }
          },
          "response": []
        },
        {
          "name": "1.2 Ver detalle del producto (guarda variante y stock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('El producto tiene al menos una variante', () => pm.expect(body.variantes.length).to.be.above(0));",
                  "const variante = body.variantes.find(v => v.stock > 0);",
                  "pm.test('Hay una variante con stock disponible para probar', () => pm.expect(variante).to.not.be.undefined);",
                  "pm.collectionVariables.set('productoVarianteId', variante.id);",
                  "pm.collectionVariables.set('stockAntes', variante.stock);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{productoId}}"] }
          },
          "response": []
        },
        {
          "name": "1.3 Agregar item al carrito",
